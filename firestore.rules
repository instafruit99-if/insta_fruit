rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users: each user reads/writes own doc; admin reads all; admin can update role/block.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.role == 'customer'
        && request.resource.data.uid == userId;
      allow update: if (isOwner(userId)
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.isBlocked == resource.data.isBlocked)
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // Categories: public read; admin write.
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products: public read; admin full write; customers may only decrement stock during checkout.
    match /products/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt'])
            && request.resource.data.stock is int
            && resource.data.stock is int
            && request.resource.data.stock >= 0
            && request.resource.data.stock < resource.data.stock);
    }

    function validOrderCreate() {
      let d = request.resource.data;
      return d.userId == request.auth.uid
        && d.paymentStatus == 'pending'
        && d.orderStatus == 'placed'
        && d.paymentMethod in ['cod', 'razorpay']
        && d.subtotal is number && d.subtotal >= 0
        && d.deliveryFee is number && d.deliveryFee >= 0
        && d.total is number && d.total >= 0
        && d.total == d.subtotal + d.deliveryFee
        && d.products is list
        && d.products.size() > 0
        && d.products.size() <= 50;
    }

    // Banners: public read; admin write.
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Cart: owner-only.
    match /cart/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Orders: authenticated customers create own placed orders; admin updates status.
    match /orders/{orderId} {
      allow create: if isSignedIn() && validOrderCreate();
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      // user can only cancel own placed order; admin can update anything.
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.userId == request.auth.uid
            && request.resource.data.orderStatus == 'cancelled'
            && resource.data.orderStatus in ['placed', 'preparing']);
      allow delete: if isAdmin();
    }

    // Payments: created only by Cloud Functions (admin SDK bypasses rules). Reads: owner or admin.
    match /payments/{paymentId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Refunds: customer creates; admin approves/rejects; both read their own.
    match /refunds/{refundId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Analytics aggregates: admin-only read; written by Cloud Functions.
    match /analytics/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Order idempotency fingerprints: Cloud Functions only.
    match /orderIdempotency/{docId} {
      allow read, write: if false;
    }
  }
}
