rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validUserAddresses() {
      return !('addresses' in request.resource.data)
        || (request.resource.data.addresses is list
            && request.resource.data.addresses.size() <= 10);
    }

    function unchangedUserStatus() {
      return request.resource.data.get('role', 'customer') == resource.data.get('role', 'customer')
        && request.resource.data.get('isBlocked', false) == resource.data.get('isBlocked', false);
    }

    function ownerProfilePatchOnly() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return keys.hasOnly(['addresses', 'defaultAddress', 'updatedAt'])
        || keys.hasOnly(['lastLocation', 'defaultAddress', 'updatedAt'])
        || keys.hasOnly(['lastLocation', 'updatedAt'])
        || keys.hasOnly(['profileImage', 'updatedAt'])
        || keys.hasOnly(['fullName', 'phone', 'updatedAt'])
        || keys.hasOnly(['favoriteProductIds', 'updatedAt']);
    }

    // Users: each user reads/writes own doc; admin reads all; admin can update role/block.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.role == 'customer'
        && request.resource.data.uid == userId
        && validUserAddresses();
      allow update: if isAdmin()
        || (isOwner(userId)
            && validUserAddresses()
            && (ownerProfilePatchOnly() || unchangedUserStatus()));
      allow delete: if isAdmin();
    }

    // Categories: public read; admin write.
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products: public read; admin full write; customers may only decrement stock during checkout.
    match /products/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt'])
            && request.resource.data.stock is int
            && resource.data.stock is int
            && request.resource.data.stock >= 0
            && request.resource.data.stock < resource.data.stock);
    }

    function orderStatusTerminal(s) {
      return s in ['delivered', 'cancelled', 'returned', 'refunded'];
    }

    function allowedOrderTransition(from, to) {
      return (from == 'placed' && to in ['accepted', 'cancelled'])
        || (from == 'accepted' && to in ['preparing', 'cancelled'])
        || (from == 'preparing' && to in ['packed', 'cancelled'])
        || (from == 'packed' && to == 'assigned_to_rider')
        || (from == 'assigned_to_rider' && to == 'outForDelivery')
        || (from == 'outForDelivery' && to == 'delivered');
    }

    function validLifecycleStatusUpdate() {
      let from = resource.data.orderStatus;
      let to = request.resource.data.orderStatus;
      return from == to || allowedOrderTransition(from, to);
    }

    function validDeliveryFeeOnCreate() {
      let d = request.resource.data;
      let sub = d.subtotal;
      let fee = d.deliveryFee;
      return (sub >= 499 && fee == 0) || (sub < 499 && fee == 25);
    }

    function validOrderCreate() {
      let d = request.resource.data;
      return d.userId == request.auth.uid
        && d.paymentStatus == 'pending'
        && d.orderStatus == 'placed'
        && d.paymentMethod in ['cod', 'razorpay']
        && d.subtotal is number && d.subtotal >= 99
        && d.deliveryFee is number && d.deliveryFee >= 0
        && validDeliveryFeeOnCreate()
        && d.total is number && d.total >= 0
        && d.total == d.subtotal + d.deliveryFee
        && d.deliverySlot is string && d.deliverySlot.size() > 0
        && (!('deliveryEligible' in d) || d.deliveryEligible == true)
        && d.products is list
        && d.products.size() > 0
        && d.products.size() <= 50
        && d.userName is string && d.userName.size() > 0 && d.userName.size() <= 120
        && d.userPhone is string && d.userPhone.size() > 0 && d.userPhone.size() <= 20;
    }

    function orderLifecycleFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['orderStatus', 'currentStatus', 'statusUpdatedAt', 'updatedAt', 'timeline', 'cancelReason']);
    }

    function orderDeliveryFieldsUnchanged() {
      return request.resource.data.deliveryFee == resource.data.deliveryFee
        && request.resource.data.deliverySlot == resource.data.deliverySlot
        && request.resource.data.subtotal == resource.data.subtotal
        && request.resource.data.total == resource.data.total;
    }

    function validAuditLogCreate() {
      let d = request.resource.data;
      return d.by == request.auth.uid
        && d.action is string
        && d.orderId is string
        && d.from is string
        && d.to is string;
    }

    // Banners: public read; admin write.
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Cart: owner-only; bounded cart size.
    match /cart/{userId} {
      allow read: if isOwner(userId);
      allow delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 50;
    }

    // Orders: authenticated customers create own placed orders; admin updates status.
    match /orders/{orderId} {
      allow create: if isSignedIn() && validOrderCreate();
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      // Admin: lifecycle fields only, valid transitions, not from terminal states.
      // Customer: cancel own order only from early states.
      allow update: if (isAdmin()
        && !orderStatusTerminal(resource.data.orderStatus)
        && request.resource.data.userId == resource.data.userId
        && validLifecycleStatusUpdate()
        && orderLifecycleFieldsOnly()
        && orderDeliveryFieldsUnchanged())
        || (isSignedIn()
            && resource.data.userId == request.auth.uid
            && request.resource.data.orderStatus == 'cancelled'
            && resource.data.orderStatus in ['placed', 'accepted', 'preparing']
            && request.resource.data.userId == resource.data.userId
            && orderLifecycleFieldsOnly()
            && orderDeliveryFieldsUnchanged());
      allow delete: if isAdmin();
    }

    function allowedPaymentTransition(from, to) {
      return (from == 'pending' && to in ['processing', 'failed', 'cancelled'])
        || (from == 'processing' && to == 'failed')
        || (from == 'failed' && to == 'processing');
    }

    function validPaymentCreate() {
      let d = request.resource.data;
      return d.userId == request.auth.uid
        && d.status == 'pending'
        && d.method in ['cod', 'razorpay']
        && d.amount is number && d.amount > 0
        && d.orderId is string;
    }

    function validClientPaymentUpdate() {
      let from = resource.data.status;
      let to = request.resource.data.status;
      return request.resource.data.userId == resource.data.userId
        && request.resource.data.orderId == resource.data.orderId
        && to != 'success'
        && allowedPaymentTransition(from, to);
    }

    // Payments: owner read; COD create pending; client may set processing/failed/cancelled; success via CF only.
    match /payments/{paymentId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && validPaymentCreate();
      allow update: if isSignedIn() && validClientPaymentUpdate();
      allow delete: if isAdmin();
    }

    // Refunds: customer creates; admin approves/rejects; both read their own.
    match /refunds/{refundId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Analytics aggregates: admin-only read; written by Cloud Functions.
    match /analytics/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Order idempotency fingerprints: Cloud Functions only.
    match /orderIdempotency/{docId} {
      allow read, write: if false;
    }

    // Audit logs: admin create/read only; immutable.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validAuditLogCreate();
      allow update, delete: if false;
    }

    function validNotificationCreate() {
      let d = request.resource.data;
      return d.userId is string
        && d.title is string
        && d.message is string
        && d.isRead == false
        && d.type is string
        && d.deduplicationKey is string;
    }

    function validNotificationReadUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        && request.resource.data.isRead == true;
    }

    // Notifications: owner read/update read flag; admin may create customer/admin notifications.
    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && validNotificationCreate()
        && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && validNotificationReadUpdate();
      allow delete: if isAdmin();
    }
  }
}
